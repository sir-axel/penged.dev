# Base URL of the API. Default "/api" (same origin: Vite proxy in dev, the Worker in prod).
# Set to e.g. https://api.example.com/api to talk to an API hosted elsewhere
# (then add this site's origin to the API's TRUSTED_ORIGINS).
# VITE_API_URL=/api
# Dev only: where the Vite dev server proxies /api to (wrangler dev).
# VITE_API_PROXY=http://localhost:8787
